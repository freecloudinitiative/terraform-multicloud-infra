#!/bin/bash
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y \
  curl \
  wget \
  jq \
  tar \
  unzip \
  libicu-dev \
  build-essential \
  make \
  git \
  rsync \
  ca-certificates \
  gnupg \
  sudo \
  python3 \
  python3-pip \
  python3-venv \
  docker.io

# Enable and start Docker daemon
systemctl enable --now docker || service docker start

# Install yq with architecture detection, strict failure handling, and checksum verification
ARCH=$(uname -m)
case $ARCH in
  x86_64) YQ_ARCH="amd64" ;;
  aarch64|arm64) YQ_ARCH="arm64" ;;
  *) echo "Unsupported architecture: $ARCH"; exit 1 ;;
esac

YQ_VERSION="v4.44.2"
wget -qO /tmp/yq "https://github.com/mikefarah/yq/releases/download/$${YQ_VERSION}/yq_linux_$${YQ_ARCH}" || { echo "Failed to download yq"; exit 1; }
wget -qO /tmp/yq_checksums "https://github.com/mikefarah/yq/releases/download/$${YQ_VERSION}/checksums" || { echo "Failed to download yq checksums"; exit 1; }

EXPECTED_HASH=$(grep "yq_linux_$${YQ_ARCH}$" /tmp/yq_checksums | awk '{print $1}')
ACTUAL_HASH=$(sha256sum /tmp/yq | awk '{print $1}')

if [ "$EXPECTED_HASH" != "$ACTUAL_HASH" ] || [ -z "$EXPECTED_HASH" ]; then
  echo "yq checksum validation failed! Expected: $EXPECTED_HASH, Actual: $ACTUAL_HASH"
  exit 1
fi

mv /tmp/yq /usr/bin/yq
chmod +x /usr/bin/yq

# Create runner user (GitHub runner cannot run as root)
useradd -m -s /bin/bash github || true
usermod -aG docker github
cd /home/github

# Download latest runner package
RUNNER_VERSION="2.336.0"
TARBALL="/home/github/actions-runner-linux-x64-$${RUNNER_VERSION}.tar.gz"
curl -o "$TARBALL" -L https://github.com/actions/runner/releases/download/v$${RUNNER_VERSION}/actions-runner-linux-x64-$${RUNNER_VERSION}.tar.gz
chown github:github "$TARBALL"

# If no PAT is provided, exit early (user can configure manually)
if [ -z "${github_pat}" ]; then
  echo "No GitHub PAT provided. Exiting runner setup."
  exit 0
fi

# Fetch dynamic runner registration token from GitHub API using the PAT
REG_TOKEN=$(curl -sX POST -H "Authorization: token ${github_pat}" \
  -H "Accept: application/vnd.github.v3+json" \
  https://api.github.com/orgs/${github_org}/actions/runners/registration-token | jq -r .token)

RUNNER_COUNT=${runners_per_vm}

for i in $(seq 1 $RUNNER_COUNT); do
  RUNNER_DIR="/home/github/runner-$i"
  mkdir -p "$RUNNER_DIR"
  tar xzf "$TARBALL" -C "$RUNNER_DIR"
  chown -R github:github "$RUNNER_DIR"

  cd "$RUNNER_DIR"
  sudo -u github ./config.sh --url "https://github.com/${github_org}" \
    --token "$REG_TOKEN" \
    --unattended \
    --replace \
    --name "$(hostname)-runner-$i"

  ./svc.sh install github
  ./svc.sh start
done
