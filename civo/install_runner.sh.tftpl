#!/bin/bash
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y \
  curl \
  jq \
  tar \
  unzip \
  libicu-dev \
  build-essential \
  make \
  git \
  rsync \
  ca-certificates \
  gnupg \
  sudo \
  python3 \
  python3-pip \
  python3-venv \
  docker.io

# Enable and start Docker daemon
systemctl enable --now docker || service docker start

# Create runner user (GitHub runner cannot run as root)
useradd -m -s /bin/bash github || true
usermod -aG docker github
cd /home/github

# Download latest runner package
RUNNER_VERSION="2.336.0"
curl -o actions-runner-linux-x64.tar.gz -L https://github.com/actions/runner/releases/download/v$${RUNNER_VERSION}/actions-runner-linux-x64-$${RUNNER_VERSION}.tar.gz
tar xzf ./actions-runner-linux-x64.tar.gz
chown -R github:github /home/github

# If no PAT is provided, exit early (user can configure manually)
if [ -z "${github_pat}" ]; then
  echo "No GitHub PAT provided. Exiting runner setup."
  exit 0
fi

# Fetch dynamic runner registration token from GitHub API using the PAT
REG_TOKEN=$(curl -sX POST -H "Authorization: token ${github_pat}" \
  -H "Accept: application/vnd.github.v3+json" \
  https://api.github.com/orgs/${github_org}/actions/runners/registration-token | jq -r .token)

# Configure the runner as the 'github' user
sudo -u github ./config.sh --url https://github.com/${github_org} --token $REG_TOKEN --unattended --replace --name "$(hostname)"

# Install systemd service and start it as root
./svc.sh install github
./svc.sh start
